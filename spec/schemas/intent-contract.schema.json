{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thyquery.local/spec/schemas/intent-contract.schema.json",
  "title": "ThyQuery intent contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "digest", "fields", "provenance", "residuals", "supersessions"],
  "properties": {
    "version": { "type": "integer", "minimum": 0 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "fields": {
      "type": "object",
      "properties": {
        "goal": {},
        "scope": {},
        "constraints": {},
        "preferences": {},
        "evidence_requirements": {},
        "acceptance_criteria": {},
        "non_goals": {},
        "risk_tier": {}
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "source_ref", "disposition"],
        "properties": {
          "kind": { "type": "string" },
          "source_ref": { "type": "string" },
          "disposition": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "residuals": { "type": "array", "items": { "type": "object" } },
    "supersessions": { "type": "array", "items": { "type": "object" } }
  }
}
